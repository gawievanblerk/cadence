# ---------------------------------------------------------------------------
# Cadence configuration.
#
# Nothing in this file is required to run the demo. With no keys set, Cadence
# runs on the built-in `scripted` provider, which is deterministic and offline.
# ---------------------------------------------------------------------------

# Storage. SQLite by default; swap for Postgres in any environment that matters.
CADENCE_DATABASE_URL=sqlite:///var/cadence.db

# Where the treatment content repository lives, and which published version to
# serve. `@latest` resolves to the newest published version in the manifest.
CADENCE_CONTENT_PATH=./content
CADENCE_CONTENT_VERSION=@latest

# ---------------------------------------------------------------------------
# Model routing.
#
# Each *role* is a job the platform needs done, not a model name. Roles are
# bound to providers here and nowhere else in the system. Changing a binding is
# a config change, not a code change.
#
#   counsellor : the conversational turn the client reads
#   extractor  : structured extraction of clinical observations from a turn
#   summariser : end-of-session episodic summary
#   embedder   : vector embeddings for semantic recall and RAG
#
# Format: provider_id:model_id
# ---------------------------------------------------------------------------
CADENCE_ROLE_COUNSELLOR=scripted:demo
CADENCE_ROLE_EXTRACTOR=scripted:demo
CADENCE_ROLE_SUMMARISER=scripted:demo
CADENCE_ROLE_EMBEDDER=hashing:local-384

# Optional ordered fallback chain, applied when the primary provider errors.
CADENCE_ROLE_COUNSELLOR_FALLBACK=

# Provider credentials. Only the ones you actually bind above are read.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Field-level encryption key for direct identifiers at rest (32 bytes, base64).
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CADENCE_ENCRYPTION_KEY=

# Pseudonymise client identifiers before any text leaves the perimeter.
CADENCE_REDACT_EGRESS=true

# Refuse to send client text to providers not on this list.
CADENCE_ALLOWED_EGRESS_PROVIDERS=scripted,hashing,ollama,openai,anthropic,gemini,deepseek

# ---------------------------------------------------------------------------
# Docker compose. docker-compose.yml on a laptop, docker-compose.prod.yml on
# the server. See docs/DEPLOY.md.
# ---------------------------------------------------------------------------
# Password for the Postgres container. Required by docker-compose.prod.yml.
DB_PASSWORD=

# Public hostname the server answers on, e.g. cadence-test.example.com. Caddy
# fetches and renews the HTTPS certificate for it. Required by
# docker-compose.prod.yml.
CADENCE_DOMAIN=
